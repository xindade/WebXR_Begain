# 私钥与数据一律不进版本库
secrets/
data/

# ★ 第二十四修：内容清单的发布产物（由 sync-content.js 从项目 src/ 生成）——
# 不入库：它是**从项目源码派生**的副本，入库会出现「改了两边不一致」。
# 服务器部署时必须跑一次：node sync-content.js --ver <版本号>
content/

# 跨语言验证工具生成的样本（每次跑 xlang/gen.js 都会变）
xlang/license.txt
xlang/license_tampered.txt
xlang/license_tampered_sig.txt
xlang/pubkey.txt

# 夹具产物（每次跑都重建）。⚠ xlang/build/src/ 里放的是**从真实工程拷进来的副本**，
# 按 skill 约束 82「副本绝不能当真身」，因此一律不入库，免得日后有人拿它当源码改。
xlang/out/
xlang/build/

# 运行时杂项
*.log
node_modules/
.DS_Store
