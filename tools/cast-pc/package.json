{
  "name": "webxr-cast-pc",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "description": "WebXR 打气球 · PC 直播接收端（HTTPS 静态托管 + 信令 + 画面接收）",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.webxrcast",
    "productName": "WebXR直播接收端",
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  }
}
