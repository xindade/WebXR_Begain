# WorkBuddy 项目数据（记忆/配置）不入库
.workbuddy/

# 系统/编辑器忽略项
.DS_Store
Thumbs.db
node_modules/
npm-debug.log*

# 构建产物（APK / 安装包体积过大，改为本地或网盘分发）
release/

# Python 字节码缓存（tools/cap-round.py 跑一次就会生成）
__pycache__/
*.pyc
# 平台内容包部署密码（本机私密，绝不入库）—— 由 tools/deploy-content.ps1 读取
deploy-password.txt
deploy-password*.txt
!deploy-password.example.txt